# ═══════════════════════════════════════════════════════════
#  نموذج متغيرات البيئة
#  انسخه إلى .env واملأ القيم الحقيقية
#      cp .env.example .env
#
#  ⚠️  ملف .env لا يُرفع إلى Git أبدًا
# ═══════════════════════════════════════════════════════════

# ── الأساسيات ──────────────────────────────────────────────
# ولّد مفتاحًا جديدًا:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-new-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── قاعدة البيانات ─────────────────────────────────────────
# PostgreSQL هو المحرك المعتمد للتطوير والإنتاج
# ⚠️  رمّز المحارف الخاصة في كلمة المرور (# → %23 ، @ → %40 ، / → %2F)
DATABASE_URL=postgres://user:password@127.0.0.1:5432/store-m
# للتشغيل السريع بلا خادم (غير مدعوم للاختبارات النهائية):
# DATABASE_URL=sqlite:///db.sqlite3

# ── الكاش ──────────────────────────────────────────────────
# اتركه فارغًا لاستخدام ذاكرة محلية بدل Redis أثناء التطوير
REDIS_URL=

# ── البريد الإلكتروني ──────────────────────────────────────
# للتطوير: اطبع الرسائل في الطرفية بدل إرسالها
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

# ── اللغة والتوقيت ─────────────────────────────────────────
LANGUAGE_CODE=ar
TIME_ZONE=Africa/Cairo

# ── الضريبة (قرار عمل — المرحلة ١) ────────────────────────
# النظام يدعم الضريبة كإعداد قابل للضبط، لا قيمة مثبتة في الكود
TAX_ENABLED=True
TAX_DEFAULT_RATE=14.00
TAX_PRICES_INCLUDE_TAX=False

# ── العملة ─────────────────────────────────────────────────
DEFAULT_CURRENCY=EGP
CURRENCY_DECIMAL_PLACES=2

# ── الفرونت إند (CORS — المرحلة ١) ────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── بوابات الدفع (المرحلة ٥) ──────────────────────────────
# مفتاح تشفير بيانات اعتماد البوابات المخزّنة في قاعدة البيانات
# ولّده: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
