# ═══════════════════════════════════════════════════════════
#  Environment variable template — **secrets only**
#
#  Copy it under the name the switch expects, and fill in the real values:
#
#      cp .env.example .env.development     # IS_PRODUCTION = False
#      cp .env.example .env.production      # IS_PRODUCTION = True
#
#  ⚠️  Neither file is ever committed to Git.
# ═══════════════════════════════════════════════════════════
#
#  Two files rather than one, split **by sensitivity, not by side**:
#
#      config/environment.py  →  read by Django and Vite alike · the switch and
#                                the domain · committed, and therefore secretless
#      .env.<environment>     →  this file · backend only · Vite never opens it
#
#  ⚠️  And the domain does not belong here. `ALLOWED_HOSTS`, `CORS_ALLOWED_ORIGINS`,
#      `CSRF_TRUSTED_ORIGINS` and `FRONTEND_BASE_URL` are all **derived**
#      from `SITE_DOMAIN` and `API_DOMAIN` in the active block of
#      `config/environment.py`. See `config/settings/base.py`.
#
#      Setting any of them here outranks the derived value — an explicit override
#      for cases outside the pattern only (a second domain · a load balancer
#      forwarding an internal host), not for ordinary use.

# ── Basics ─────────────────────────────────────────────────
# Generate a fresh key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# ⚠️  **Wrap it in single quotes.**
#
#     A `#` inside the value starts a comment as far as django-environ is concerned, so a
#     50-character key reaches Django 5 characters long — and 64% of generated keys contain `#`.
#     And do not use double quotes: those keep the quote inside the value and truncate as well.
#
#     The only symptom is `security.W009` in `check --deploy` — a warning, not an error.
DJANGO_SECRET_KEY='change-me-generate-a-new-one'
DJANGO_DEBUG=True

# ── Database ───────────────────────────────────────────────
# PostgreSQL is the supported engine for development and production
# ⚠️  Encode special characters in the password (# → %23 , @ → %40 , / → %2F)
DATABASE_URL=postgres://user:password@127.0.0.1:5432/store-m
# For a quick server-less run (not supported for final testing):
# DATABASE_URL=sqlite:///db.sqlite3

# ── Cache ──────────────────────────────────────────────────
# Leave empty to use local memory instead of Redis during development
REDIS_URL=

# ── Email ──────────────────────────────────────────────────
# For development: print messages to the terminal instead of sending them
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

# ── Time ───────────────────────────────────────────────────
# ⚠️  The default language lives in `.env.public` (PUBLIC_DEFAULT_LOCALE) —
#     read by the server and the frontend alike. `LANGUAGE_CODE` here is an
#     explicit server-only override that makes it differ from the frontend on purpose.
TIME_ZONE=Africa/Cairo

# ── Tax (business decision — phase 1) ──────────────────────
# The system supports tax as a configurable setting, never a value fixed in code
TAX_ENABLED=True
TAX_DEFAULT_RATE=14.00
TAX_PRICES_INCLUDE_TAX=False

# ── Currency ───────────────────────────────────────────────
DEFAULT_CURRENCY=EGP
CURRENCY_DECIMAL_PLACES=2

# ── Frontend (CORS) ────────────────────────────────────────
# ⚠️  **Nothing here.** See `.env.public`.
#
#     This section used to carry `FRONTEND_BASE_URL` and `CORS_ALLOWED_ORIGINS`
#     while `web/.env` carried the same domain in a third form. A mismatched
#     origin makes the browser block every response silently: the server returns
#     200 and the browser refuses to hand it to the code, and the error surfaces
#     in the browser console, not the Django log — so it is hunted in the wrong place.
#
#     Deriving from a single source makes this case impossible rather than rare.

# ── Sitemaps ───────────────────────────────────────────────
# ⚠️  Stays `False` in every environment except production.
#
#     An indexed staging environment competes with the real site for the same
#     keywords and exposes test data as though it were products. `robots.txt`
#     disallows everything while this stays off.
SEO_INDEXING_ENABLED=False

# ── Payment gateways (phase 5) ─────────────────────────────
# Encryption key for gateway credentials stored in the database
# Generate it with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️  **Mandatory in production** — `config/settings/prod.py` will not boot without it.
#
#     Withholding the key from the API alone protected one path and left the
#     other open: a backup or a SQL leak would hand over the gateway keys in
#     full. A save without a key is **rejected**, never downgraded to plaintext.
#
# ⚠️  And it must not change after the first save: changing it makes every
#     stored value unreadable. To rotate, put the new key first and the old one
#     after it separated by a comma, re-save the rows, then drop the old one:
#
#         FIELD_ENCRYPTION_KEY=<new>,<old>
FIELD_ENCRYPTION_KEY=

# ── Django admin path ──────────────────────────────────────
# ⚠️  **Obscurity, not authentication.** It removes the panel from the list of
#     paths every credential-stuffing bot tries first; the login and the
#     permissions behind it remain the actual protection.
#
# ⚠️  And it belongs **here**, never in `config/environment.py` — that file is
#     committed to Git, so writing the path there publishes it to every clone.
#
#     Leave it as `admin` in development. Set a real value in production:
#         ADMIN_URL=some-unguessable-segment
ADMIN_URL=admin
