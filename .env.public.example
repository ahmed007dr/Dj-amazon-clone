# ═══════════════════════════════════════════════════════════
#  Shared configuration template — backend and frontend
#  Copy to .env.public and set the domains
#      cp .env.public.example .env.public
# ═══════════════════════════════════════════════════════════
#
#  The split between this file and `.env` is **by sensitivity, not by side**:
#
#      .env.public  →  read by Django and Vite alike · no secrets · public
#      .env         →  backend only · secrets and the database
#
#  ⚠️  **Never put a secret here.** What is in this file may end up in the
#      browser bundle, and the browser bundle is readable by every visitor.
#
#  ⚠️  Switching environment (development · staging · production) means changing
#      this file alone. No second file in `web/`, no address written in any code.

# ── Scheme ─────────────────────────────────────────────────
# ⚠️  `https` is **mandatory in production** — `manage.py check` refuses to
#     boot with `http` when `DJANGO_SETTINGS_MODULE=config.settings.prod`
PUBLIC_SCHEME=https

# ── Domains ────────────────────────────────────────────────
# The site a human visits (the frontend)
#   development:  localhost:5173     ← the port is the Vite dev server's
#   production:   shop.example.com
PUBLIC_SITE_DOMAIN=shop.example.com

# The Django server
#   development:  127.0.0.1:8000
#   production:   api.example.com
PUBLIC_API_DOMAIN=api.example.com

# API prefix — appended to the server domain
PUBLIC_API_PREFIX=/api/v1

# ⚠️  Media origin — empty = follows the server domain.
#     Set it explicitly when media moves to a CDN.
#     Example: https://cdn.example.com
PUBLIC_MEDIA_ORIGIN=

# ── Language ───────────────────────────────────────────────
# Default language for both sides — Django derives LANGUAGE_CODE from it
PUBLIC_DEFAULT_LOCALE=ar
