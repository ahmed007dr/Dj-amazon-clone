# ═══════════════════════════════════════════════════════════
#  نموذج الإعداد المشترك — الباك إند والفرونت إند
#  انسخه إلى .env.public واضبط الدومينات
#      cp .env.public.example .env.public
# ═══════════════════════════════════════════════════════════
#
#  الفصل بين هذا الملف و`.env` **بالحساسية لا بالجهة**:
#
#      .env.public  →  يقرأه Django و Vite معًا · بلا سرّ · علني
#      .env         →  الباك إند وحده · الأسرار وقاعدة البيانات
#
#  ⚠️  **لا تضع سرًّا هنا.** ما في هذا الملف قد ينتهي في حزمة
#      المتصفح، وحزمة المتصفح يقرؤها كل زائر.
#
#  ⚠️  وتبديل البيئة (تطوير · تجريب · إنتاج) = تغيير هذا الملف
#      وحده. لا ملف ثانٍ في `web/` ولا عنوان مكتوب في أي كود.

# ── المخطَّط ───────────────────────────────────────────────
# ⚠️  `https` **إلزامي في الإنتاج** — `manage.py check` يرفض
#     الإقلاع بـ `http` مع `DJANGO_SETTINGS_MODULE=config.settings.prod`
PUBLIC_SCHEME=https

# ── الدومينات ─────────────────────────────────────────────
# الموقع الذي يزوره الإنسان (الفرونت إند)
#   التطوير:  localhost:5173     ← المنفذ هو منفذ خادم Vite
#   الإنتاج:  shop.example.com
PUBLIC_SITE_DOMAIN=shop.example.com

# خادم Django
#   التطوير:  127.0.0.1:8000
#   الإنتاج:  api.example.com
PUBLIC_API_DOMAIN=api.example.com

# بادئة الـ API — تُلحَق بدومين الخادم
PUBLIC_API_PREFIX=/api/v1

# ⚠️  أصل الوسائط — فارغ = يتبع دومين الخادم.
#     يُضبط صراحةً حين تنتقل الوسائط إلى CDN.
#     مثال: https://cdn.example.com
PUBLIC_MEDIA_ORIGIN=

# ── اللغة ─────────────────────────────────────────────────
# اللغة الافتراضية للطرفين — منها يشتق Django قيمة LANGUAGE_CODE
PUBLIC_DEFAULT_LOCALE=ar
