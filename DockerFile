# Use the official Python image with tag 3.11.8-slim-bullseye
FROM python:3.11.8-slim-bullseye

# Show logs in Python without buffering
ENV PYTHONUNBUFFERED=1

# Update package lists and install necessary dependencies
RUN apt-get update && apt-get -y install gcc libpq-dev

# Set the working directory to /app
WORKDIR /app

# Copy the requirements files into the container at /app
# ⚠️  The whole directory, not one file — `dev.txt` opens with `-r base.txt`,
#     so copying it alone makes the install fail on a missing include.
COPY requirements/ /app/requirements/

# Install the project dependencies
# ⚠️  This image is the development one (`docker-compose.yml` runs `runserver`
#     through it), so it installs `dev.txt`. A production image installs
#     `requirements/base.txt` — see requirements/base.txt for what that excludes.
RUN pip install -r requirements/dev.txt

# Copy all project files into the container at /app
COPY . /app/
