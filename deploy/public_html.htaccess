# ═══════════════════════════════════════════════════════════
#  ⇒  /home/medboxne/public_html/.htaccess
#
#  The site root a human visits — it serves the frontend build (web/dist)
#  and Django never touches it. The server lives at api.med-box.net.
#
#  ⚠️  The order here is deliberate: HTTPS ← block private ← real files ← SPA.
#      The SPA rule swallows everything the preceding rules did not catch, so any
#      rule placed after it never runs.
# ═══════════════════════════════════════════════════════════

Options -Indexes

RewriteEngine On


# ── 1. Force HTTPS ─────────────────────────────────────────
# ⚠️  Django enforces HTTPS on its own domain alone (SECURE_SSL_REDIRECT in prod.py).
#     This domain is static files that never pass through Django, so nothing enforces it but here.
#
# ⚠️  And two conditions, because LiteSpeed behind a load balancer may not set %{HTTPS}:
#     relying on one alone produces either an endless redirect loop
#     or a site that silently stays on http.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


# ── 2. Private media — blocked ─────────────────────────────
# ⚠️  **This is the only barrier.** MEDIA_ROOT has not yet been split into public and private
#     (config/settings/base.py:442 is not overridable by an environment variable),
#     so the entire media directory reaches here through a symbolic link — including:
#
#         private/customer-documents/   pharmacy licences and verification documents
#         private/expense-attachments/  invoices bearing the landlord's name and amount
#         mail/inbound/                 inbound mail attachments
#
#     Their legitimate serving goes through Django with a 5-minute signature and an
#     ownership check (customers/api.py:133) that reads straight from disk — so blocking
#     the path here does not break a sound download, and cuts off the direct path alone.
#
# ⚠️  And 404, not 403: the latter confirms the file exists.
RedirectMatch 404 ^/media/private/
RedirectMatch 404 ^/media/mail/


# ── 3. No execution inside the upload directory ────────────
# ⚠️  A directory users upload into that sits under the web root = remote execution
#     if a file ending in an extension the server executes is uploaded successfully. The check in
#     core/files.py restricts the types to an allow-list, and this is the second layer:
#     even if a file gets through, it is served as text and never executed.
#
# ⚠️  <Directory> **does not work inside .htaccess** — it is a server configuration directive,
#     and putting it here brings the whole site down with a 500. Disabling the engine inside the
#     media directory belongs in deploy/media.htaccess, which goes in that directory itself.
<FilesMatch "\.(php|phtml|php[0-9]|pl|py|cgi|sh|lua)$">
    Require all denied
</FilesMatch>


# ── 4. Files that actually exist are served as they are ────
# ⚠️  /media is a symbolic link to /home/medboxne/med-box/media. Excluding it here
#     stops the SPA rule swallowing it and returning index.html instead of the image —
#     the fault that appears as broken images on every page while the server answers 200.
#
# ⚠️  /static is listed too, but its symlink does **not** live in this document root.
#
#     Django writes static URLs relative (`/static/…`), so the browser requests them
#     from whichever domain served the page — and /admin/ is served by api.med-box.net.
#     The symlink therefore belongs in the API subdomain's root, not here. It stays
#     named in this condition anyway: if a static symlink is ever added to this domain
#     as well, the SPA rule must not swallow it. Costless, and it removes a trap.
RewriteCond %{REQUEST_URI} ^/(media|static)/ [OR]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# ── 5. Single-page application routes ──────────────────────
# ⚠️  React Router routes in the browser, and the server knows neither /cart nor /orders.
#     Without this line, navigation inside the application works and refreshing the page
#     or opening the link directly fails with a 404 — a fault that shows for the user, not the developer.
RewriteRule ^ /index.html [L]


# ── 6. Caching ─────────────────────────────────────────────
# ⚠️  index.html with no caching, and the assets with the maximum.
#     Vite builds the asset names with a fingerprint of their content (app-4f2a9c.js), so changing
#     the content changes the name — a full year is safe. index.html, by contrast, is what
#     carries the new asset names, and caching it means a deployment the visitor never receives.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 month"
    ExpiresByType image/jpeg               "access plus 1 month"
    ExpiresByType image/png                "access plus 1 month"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

<FilesMatch "^(index\.html|sw\.js)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</FilesMatch>


# ── 7. Security headers ────────────────────────────────────
# ⚠️  Their counterpart in Django covers the server's domain alone — this is a different domain
#     served by Apache, so prod.py's settings never reach it.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    # One year — matching SECURE_HSTS_SECONDS in prod.py
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>


# ── 8. Compression ─────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
