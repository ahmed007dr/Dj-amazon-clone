# ═══════════════════════════════════════════════════════════
#
#  ⚠️  لا يوجد عنوان API مكتوب يدويًا في أي مكان في الفرونت إند.
#      تبديل البيئة (تطوير · تجريب · إنتاج) = تغيير هذا الملف
#      وحده. صفر تعديل كود.
#
#  ⚠️  كل متغيّر يبدأ بـ VITE_ يُحقن في حزمة المتصفح ويصير
#      **علنيًا**. لا تضع هنا أي سر.

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_MEDIA_BASE_URL=http://127.0.0.1:8000

# اللغة الافتراضية قبل أي اختيار من المستخدم
VITE_DEFAULT_LOCALE=ar
